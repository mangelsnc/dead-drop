# Fastlane Appfile — DeadDrop iOS
# https://docs.fastlane.tools/advanced/#appfile

# The bundle identifier of your app
app_identifier("com.deaddrop.app")

# Your Apple ID email (used for TestFlight uploads and signing)
# Set via environment variable: FASTLANE_USER
apple_id(ENV["FASTLANE_USER"] || "")

# Team ID from Apple Developer Portal
# Set via environment variable: FASTLANE_TEAM_ID
team_id(ENV["FASTLANE_TEAM_ID"] || "")

# For App Store Connect API key authentication (preferred for CI):
# Set these environment variables:
#   APP_STORE_CONNECT_API_KEY_KEY_ID
#   APP_STORE_CONNECT_API_KEY_ISSUER_ID
#   APP_STORE_CONNECT_API_KEY_KEY_FILEPATH (path to .p8 file)
